  },
  {
    "text": "«Ещё одна катка»",
    "group": "profile",
    "context": "div · panel stat-panel"
  },
  {
    "text": "Совесть",
    "group": "profile",
    "context": "div · panel stat-panel"
  },
  {
    "text": "Сон",
